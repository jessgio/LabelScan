# Copy to .env.local. The Aeris Vercel project can leave the brand values unset.
# The fti-label-scan project overrides them.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. When unset, the daily report uses get_daily_metrics and CRON_SECRET.
SUPABASE_SERVICE_ROLE_KEY=

CRON_SECRET=
OPENROUTER_API_KEY=
RESEND_API_KEY=
REPORT_RECIPIENT=
REPORT_SENDER=

# Aeris defaults. FTI deployment:
# NEXT_PUBLIC_BRAND_NAME=FTI Label Scanner
# NEXT_PUBLIC_BRAND_MARK=FTI
# NEXT_PUBLIC_BRAND_TAGLINE=From This Island warehouse shipping
# NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=fromthisisland.com
# NEXT_PUBLIC_BRAND_COLOR="#1f6f5b"
# NEXT_PUBLIC_BRAND_COLOR_DARK="#16574a"
NEXT_PUBLIC_BRAND_NAME=Label Scanner
NEXT_PUBLIC_BRAND_MARK=LS
NEXT_PUBLIC_BRAND_TAGLINE=Warehouse shipping throughput
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=aerisbeaute.com
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta
NEXT_PUBLIC_BRAND_COLOR="#4f46e5"
NEXT_PUBLIC_BRAND_COLOR_DARK="#4338ca"
